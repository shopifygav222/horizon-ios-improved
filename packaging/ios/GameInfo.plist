<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Horizon Pocket Edition, "Horizon PE" under its icon (packaging/ios/project.yml's StarlingGame target,
  IOS-SYNC.md): an iOS port of Horizon (Minecraft: Java Edition in Rust) based on Starling, Horizon's Android
  port, drawn with Metal. Its executable is the cross-compiled
  `horizon-ios-game` binary. The bundle identifier and the executable's name are still Starling's
  (dev.horizon.starling, Starling): changed, the app would install as another one, without the player's
  worlds. A separate app from Horizon's iOS app (dev.horizon.game): both install side by side, and the
  setup brings Horizon's worlds over.

  There is no principal class, no nib and no storyboard, on purpose: winit's iOS backend passes its own
  application delegate to UIApplicationMain and registers WinitSceneDelegate (third_party/winit,
  IOS_PATCHES.md) for the one window scene declared below.

  UIFileSharingEnabled and LSSupportsOpeningDocumentsInPlace put the game folder (the app's Documents:
  worlds, packs, mods, options, logs) in the Files app as "Horizon PE", where Android's shared storage has
  its Starling folder. The document types are what Starling's Android app opens: its own .starling files,
  Horizon's mods (.hmod, .hnmod), Bedrock packs and worlds, zips (packs, worlds, prepared resources) and
  PNG skins; each goes to the import inbox (crates/horizon-client/src/import.rs).
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Horizon PE</string>
	<key>CFBundleExecutable</key>
	<string>Starling</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Horizon PE</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Horizon Pocket Edition is an iOS port of Horizon, based on Starling; all MIT licensed. Not an official Minecraft product; not approved by or associated with Mojang or Microsoft.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A native mod built into this app asked to use the microphone.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- With UIFileSharingEnabled, this is what lists Documents under "On My iPhone" in the Files app:
	     sharing alone reaches it only from a computer (Finder). -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Horizon and Starling content</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.juanluci.starling.content</string>
				<string>dev.horizon.mod</string>
				<string>dev.horizon.native-mod</string>
				<string>com.mojang.minecraft.bedrock</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Packs, worlds and skins</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>com.modrinth.mrpack</string>
				<string>public.png</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.juanluci.starling.content</string>
			<key>UTTypeDescription</key>
			<string>Starling content</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>starling</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.horizon.mod</string>
			<key>UTTypeDescription</key>
			<string>Horizon mod</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>hmod</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.horizon.native-mod</string>
			<key>UTTypeDescription</key>
			<string>Horizon native mod</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>hnmod</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.mojang.minecraft.bedrock</string>
			<key>UTTypeDescription</key>
			<string>Minecraft Bedrock content</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mcpack</string>
					<string>mcaddon</string>
					<string>mcworld</string>
					<string>mctemplate</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.modrinth.mrpack</string>
			<key>UTTypeDescription</key>
			<string>Modrinth modpack</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mrpack</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Plain http only to local addresses (a LAN server's resource pack, a computer on the same Wi-Fi);
	     anything on the internet still needs https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Horizon PE finds worlds opened to LAN, plays with friends nearby and joins servers on this network.</string>
	<!-- F2 adds the screenshot to Photos, as Android publishes it to the gallery. iOS ends an app that
	     asks without this description. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Horizon PE saves your screenshots to Photos.</string>
	<!-- Gyro aiming: CoreMotion's gyroscope asks for nothing, but some iOS versions want the motion
	     description present before any motion API is touched. -->
	<key>NSMotionUsageDescription</key>
	<string>Horizon PE aims with the phone's gyroscope when the touch layout asks for it.</string>
	<!-- Without it an iPhone caps every app at 60 Hz; with it ProMotion follows the game's frames. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Starling</string>
					<key>UISceneDelegateClassName</key>
					<string>WinitSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- Every orientation the launcher's Orientation setting can choose; the window narrows it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
