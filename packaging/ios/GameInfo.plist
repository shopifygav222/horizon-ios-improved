<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The game bundle's Info.plist (packaging/ios/project.yml's HorizonGame target). Its executable is the
  cross-compiled `horizon-ios-game` binary: Android's launcher and game, drawn with Metal.

  There is no principal class, no nib and no storyboard, on purpose: winit's iOS backend passes its own
  application delegate to UIApplicationMain and registers WinitSceneDelegate (third_party/winit,
  IOS_PATCHES.md) for the one window scene declared below.

  UIFileSharingEnabled puts the game's Documents folder (worlds, packs, mods, options and reports) in the Files
  app, where Android's DocumentsProvider shows them.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Horizon</string>
	<key>CFBundleExecutable</key>
	<string>Horizon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>dev.horizon.game</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Horizon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.7.8</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Horizon is MIT licensed. Not an official Minecraft product; not approved by or associated with Mojang or Microsoft.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- With UIFileSharingEnabled, this is what lists Documents under "On My iPhone" in the Files app:
	     sharing alone reaches it only from a computer (Finder). -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Plain http only to local addresses (a LAN server's resource pack, a computer on the same Wi-Fi);
	     anything on the internet still needs https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Horizon finds worlds opened to LAN and joins servers on this network.</string>
	<!-- F2 adds the screenshot to Photos, as Android publishes it to the gallery. iOS ends an app that
	     asks without this description. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Horizon saves your screenshots to Photos.</string>
	<!-- Without it an iPhone caps every app at 60 Hz; with it ProMotion follows the game's frames. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>Horizon</string>
					<key>UISceneDelegateClassName</key>
					<string>WinitSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- Every orientation the launcher's Orientation setting can choose; the window narrows it
	     (crates/horizon-client/src/ios/display.rs). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
